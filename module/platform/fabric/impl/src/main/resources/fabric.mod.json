{
  "schemaVersion": 1,
  "id": "${modId}",
  "version": "${modV}",
  "name": "${modName}",
  "description": "${modDesc}",
  "authors": [
    "${modAuthors}"
  ],
  "contact": {
    "homepage": "${gitUrl}",
    "sources": "${gitUrl}",
    "issues": "${gitUrl}/issues"
  },
  "license": "${license}",
  "icon": "${modId}.png",
  "environment": "*",
  "entrypoints": {
    "main": [
      "com.swacky.${modId}.common.OhmegaMain"
    ],
    "client": [
      "com.swacky.${modId}.client.OhmegaClientMain"
    ],
    "fabric-datagen": [
      "com.swacky.${modId}.datagen.OhmegaDataGenerationMain"
    ],
    "jei_mod_plugin": [
      "com.swacky.${modId}.compat.jei.common.OhmegaJeiMain"
    ],
    "ohmega-common": [
      "com.swacky.${modId}.compat.polymer.common.OhmegaPolymerMain"
    ],
    "rei_client": [
      "com.swacky.${modId}.compat.rei.client.OhmegaReiClientMain"
    ],
    "rrv_client": [
      "com.swacky.${modId}.compat.rrv.client.OhmegaRrvClientMain"
    ]
  },
  "mixins": [
    "${modId}_common.mixins.json",
    "${modId}_fabric.mixins.json"
  ],
  "accessWidener": "${modId}_fabric.accesswidener",
  "depends": {
    "fabricloader": "${loaderFabricVRange}",
    "minecraft": "~${mcVRangeMin}",
    "java": ">=${javaV}",
    "fabric-api": "*",
    "forgeconfigapiport": "${loaderFabricForgeConfigApiPortVRange}"
  },
  "custom": {
    "modmenu": {
      "links": {
        "modmenu.crowdin": "${crowdinUrl}",
        "modmenu.curseforge": "${curseUrl}",
        "modmenu.discord": "${discordUrl}",
        "modmenu.modrinth": "${modrinthUrl}",
        "modmenu.wiki": "${gitUrl}/wiki"
      },
      "badges": ["library"],
      "update_checker": true
    }
  }
}