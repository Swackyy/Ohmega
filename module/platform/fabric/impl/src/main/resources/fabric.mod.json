{
  "schemaVersion": 1,
  "id": "ohmega",
  "version": "${modVersion}",
  "name": "${modName}",
  "description": "${modDescription}",
  "authors": [
    "${modAuthors}"
  ],
  "contact": {
    "homepage": "${modUrlGithub}",
    "sources": "${modUrlGithub}",
    "issues": "${modUrlGithub}/issues"
  },
  "license": "${modLicense}",
  "icon": "ohmega.png",
  "environment": "*",
  "entrypoints": {
    "main": [
      "com.swacky.ohmega.common.OhmegaMain"
    ],
    "client": [
      "com.swacky.ohmega.client.OhmegaClientMain"
    ],
    "fabric-datagen": [
      "com.swacky.ohmega.datagen.OhmegaDataGenerationMain"
    ],
    "ohmega-client-unsafe": [
      "com.swacky.ohmega.compat.figura.client.OhmegaFiguraClientMain"
    ],
    "ohmega-common-unsafe": [
      "com.swacky.ohmega.compat.polymer.OhmegaPolymerMain"
    ],
    "figura_api": [
      "com.swacky.ohmega.compat.figura.client.api.OhmegaFiguraClientAPIMain"
    ],
    "figura_event": [
      "com.swacky.ohmega.compat.figura.client.event.OhmegaFiguraClientEventsMain"
    ],
    "jei_mod_plugin": [
      "com.swacky.ohmega.compat.jei.common.OhmegaJeiMain"
    ],
    "rei_client": [
      "com.swacky.ohmega.compat.rei.client.OhmegaReiClientMain"
    ],
    "rrv_client": [
      "com.swacky.ohmega.compat.rrv.client.OhmegaRrvClientMain"
    ]
  },
  "mixins": [
    "ohmega_common.mixins.json",
    "ohmega_fabric.mixins.json"
    ${extraMixinConfigs}
  ],
  "accessWidener": "ohmega_fabric-api.accesswidener",
  "depends": {
    "fabricloader": "${platformFabricVersionRange}",
    "minecraft": "~${minecraftVersionRangeMin}",
    "java": ">=${configurationJavaVersion}",
    "fabric-api": "*",
    "forgeconfigapiport": "${platformFabricDependencyForgeConfigApiPortVersionRange}"
  },
  "custom": {
    "modmenu": {
      "links": {
        "modmenu.crowdin": "${modUrlCrowdin}",
        "modmenu.curseforge": "${modUrlCurseforge}",
        "modmenu.discord": "${modUrlDiscord}",
        "modmenu.modrinth": "${modUrlModrinth}",
        "modmenu.wiki": "${modUrlWiki}"
      },
      "badges": [
        "library"
      ],
      "update_checker": true
    }
  }
}