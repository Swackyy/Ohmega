{
  "schemaVersion": 1,
  "id": "${modId}",
  "version": "${modV}",
  "name": "${modName}",
  "description": "${modDescFabric}",
  "authors": [
    "${modAuthors}"
  ],
  "contact": {
    "homepage": "${gitUrl}",
    "sources": "${gitUrl}",
    "issues": "${gitUrl}/issues"
  },
  "license": "${license}",
  "icon": "${modId}.png",
  "environment": "*",
  "entrypoints": {
    "main": [
      "com.swacky.${modId}.common.Ohmega"
    ],
    "client": [
      "com.swacky.${modId}.client.OhmegaClient"
    ]
  },
  "mixins": [
    "${modId}.mixins.json"
  ],
  "accessWidener": "aw.accesswidener",
  "depends": {
    "fabricloader": "${loaderFabricVRange}",
    "minecraft": "${mcV}",
    "java": ">=${javaV}",
    "fabric-api": "*",
    "forgeconfigapiport": "${loaderFabricForgeConfigApiPortVRange}"
  },
  "custom": {
    "modmenu": {
      "links": {
        "modmenu.curseforge": "${curseUrl}",
        "modmenu.discord": "${discordUrl}",
        "modmenu.modrinth": "${modrinthUrl}",
        "modmenu.wiki": "${gitUrl}/wiki"
      },
      "badges": ["library"]
    },
    "update_checker": true
  }
}